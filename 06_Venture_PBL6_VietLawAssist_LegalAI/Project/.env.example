# === VietLawAssist Environment Configuration ===
# Copy this file to .env and fill in values
# SECURITY: Never commit .env to git!

# --- Application ---
APP_NAME=VietLawAssist
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
DATABASE_URL=sqlite:///data/law_corpus.db

# --- BM25 Configuration ---
BM25_K1=1.5
BM25_B=0.75
BM25_TOP_K=5
BM25_INDEX_PATH=data/bm25_index.pkl

# --- Tokenizer ---
# Options: pyvi, underthesea
TOKENIZER=pyvi

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --- CORS (Frontend URL) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Future: ML Models (Phase 3-4) ---
# PHOBERT_MODEL=bkai-foundation-models/vietnamese-bi-encoder
# QWEN_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# DEVICE=cuda
# MAX_NEW_TOKENS=512
